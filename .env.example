# API key for an OpenAI-compatible chat endpoint.
# Leave this blank to use the offline shelf-life heuristic.
LLM_API_KEY=

# Optional. Defaults to the OpenAI API.
LLM_BASE_URL=https://api.openai.com/v1

# Optional. Defaults to gpt-4o-mini.
LLM_MODEL=gpt-4o-mini

# Optional request timeout in seconds.
LLM_TIMEOUT_SECONDS=30

# mock reads fixtures/sensor.sample.json.
# live reads real weather, frost, and soil moisture from Open-Meteo (free, no
# key). If the network is down it falls back to the mock reading and says so.
SENSOR_MODE=mock

# Where the garden is, for SENSOR_MODE=live. Defaults to the sample fixture's
# place (Hudson Valley, NY).
FALLOW_LATITUDE=
FALLOW_LONGITUDE=
FALLOW_LOCATION=
